# Copy to .env and set both blank credentials before starting the services.
POSTGRES_DB=school
POSTGRES_USER=school
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Set DATABASE_URL to use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://school:SET_POSTGRES_PASSWORD@localhost:5432/school?schema=public
# Use a deliverable address; seeded accounts must verify before login.
ADMIN_EMAIL=admin@university.local
ADMIN_PASSWORD=

# Use Mailpit locally; choose resend in deployment after verifying a sender domain.
EMAIL_PROVIDER=mailpit
EMAIL_FROM="University SIS <noreply@example.test>"
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Resend settings are required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Generate a random secret of at least 32 bytes for access-token signing.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000

REDIS_PORT=6379
# Optional full Redis URI; otherwise localhost and REDIS_PORT are used.
REDIS_URL=
RBAC_CACHE_TTL_SECONDS=60

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=school-files
