# Copy to .env and set both blank credentials before starting the services.
POSTGRES_DB=school
POSTGRES_USER=school
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Set DATABASE_URL to use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://school:SET_POSTGRES_PASSWORD@localhost:5432/school?schema=public
# Use a deliverable address; seeded accounts must verify before login.
ADMIN_EMAIL=admin@university.local
ADMIN_PASSWORD=

# Use Mailpit locally; choose resend in deployment after verifying a sender domain.
EMAIL_PROVIDER=mailpit
EMAIL_FROM="University SIS <noreply@example.test>"
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Resend settings are required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Generate a random secret of at least 32 bytes for access-token signing.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000

REDIS_PORT=6379
# Optional full Redis URI; otherwise localhost and REDIS_PORT are used.
REDIS_URL=
RBAC_CACHE_TTL_SECONDS=60

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=school-files
# The endpoint must be reachable by both the API and browsers opening signed image URLs.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1

# Public application URL used to build login links in emails.
APP_URL=http://localhost:3000
# Days before an initial temporary password expires.
TEMP_PASSWORD_TTL_DAYS=7
# Generate a random secret of at least 32 bytes for website request signatures.
WEBSITE_INTEGRATION_SECRET=
# Comma-separated hostnames permitted in meeting links; replace this example host.
MEETING_ALLOWED_HOSTS=meet.university.example
# Minimum continuous online attendance share required to count as present.
ATTENDANCE_MIN_CONTINUOUS_PERCENT=75
# Maximum reconnect pause that may be merged into a continuous stay.
ATTENDANCE_RECONNECT_GRACE_SECONDS=180
# Attendance percentage below which the system should show a warning.
ATTENDANCE_WARNING_PERCENT=75
# Application fee in integer minor currency units; set the institution's amount.
APPLICATION_FEE_AMOUNT_MINOR=
# Three-letter currency code for the application fee; set the institution's currency.
CURRENCY=
# Institution name used in system branding and communications.
SCHOOL_NAME=University SIS
# Object-storage key for the institution logo; not a public URL.
SCHOOL_LOGO_KEY=branding/school-logo.svg
# Seed-only online card flag; keep disabled.
FEATURE_ONLINE_CARD_ENABLED=false
# Seed-only online bank flag; keep disabled.
FEATURE_ONLINE_BANK_ENABLED=false
# Seed-only online mobile flag; keep disabled.
FEATURE_ONLINE_MOBILE_ENABLED=false
