# Copy to .env and set both blank credentials before starting the services.
POSTGRES_DB=school
POSTGRES_USER=school
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Set DATABASE_URL to use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://school:SET_POSTGRES_PASSWORD@localhost:5432/school?schema=public
ADMIN_EMAIL=admin@university.local
ADMIN_PASSWORD=

REDIS_PORT=6379

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=school-files
